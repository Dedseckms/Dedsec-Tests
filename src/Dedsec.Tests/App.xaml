<!-- Override system brushes used by nested WPF templates, including empty grid areas. -->
<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#18212A"/>
<SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#14191F"/>
<SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E9F1F6"/>
