<Window x:Class="Dedsec.Tests.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Dedsec Tests" Background="{DynamicResource Base}" Foreground="#F1F5F8" FontFamily="Segoe UI" FontSize="14" Width="1200" Height="820" MinWidth="920" MinHeight="640" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
<Border BorderBrush="#323C45" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
<Border Background="#11161C" MouseLeftButtonDown="DragTitle"><Grid Margin="18,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/app.png" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="DEDSEC" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/><TextBlock Text=" / TESTS" Foreground="{DynamicResource Accent}" FontSize="17" VerticalAlignment="Center"/><TextBlock x:Name="VersionLabel" Text="  PREVIEW" Foreground="#7C8A97" FontSize="11" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="─" Padding="14,7" Margin="0,7,4,7" Click="Minimize"/><Button Content="□" Padding="14,7" Margin="0,7,4,7" Click="Maximize"/><Button Content="✕" Padding="14,7" Margin="0,7,0,7" Click="CloseWindow"/></StackPanel></Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#10151B" BorderBrush="#252E37" BorderThickness="0,0,1,0"><DockPanel Margin="16,24,12,16"><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="ТВОЁ ЖЕЛЕЗО.&#10;ТВОЙ КОНТРОЛЬ." Foreground="#728190" FontSize="11" FontWeight="Bold" LineHeight="20"/></StackPanel><StackPanel x:Name="Navigation"><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#687989" FontSize="10" Margin="8,0,0,18"/><Button Content="◈   Обзор" Tag="overview" Click="Navigate" HorizontalContentAlignment="Left"/><Button Content="▷   Тестирование" Tag="tests" Click="Navigate"/><Button Content="⌁   Датчики" Tag="sensors" Click="Navigate"/><Button Content="▤   Процессы" Tag="processes" Click="Navigate"/><Button Content="✓   Диагностика" Tag="diagnostics" Click="Navigate"/><Button Content="◷   Отчёты" Tag="reports" Click="Navigate"/><Button Content="⚙   Настройки" Tag="settings" Click="Navigate"/></StackPanel></DockPanel></Border>
<ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Margin="24,20,16,16"/></ScrollViewer><Grid x:Name="FixedPage" Grid.Column="1" Margin="20,16,20,16" Visibility="Collapsed"/></Grid>
<Border Grid.Row="2" Background="#11161C" BorderBrush="#252E37" BorderThickness="0,1,0,0"><DockPanel Margin="16,0"><Button x:Name="GlobalStop" DockPanel.Dock="Right" Content="Остановить тест" Background="#6B302D" Visibility="Collapsed" Padding="10,2" Margin="8,3,0,3" Click="StopAll"/><TextBlock x:Name="Activity" Text="Подготовка…" Foreground="#A5B3C0" VerticalAlignment="Center" FontSize="12"/><TextBlock Text="LOCAL FIRST  /  ПУБЛИКАЦИЯ ПО СОГЛАСИЮ" Foreground="#6E7F8D" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"/></DockPanel></Border>
</Grid></Border></Window>
